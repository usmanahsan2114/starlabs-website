# ============================================================================
# Star Laboratories (Pvt) Ltd — .htaccess
# Performance, security and SEO configuration
# ============================================================================

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php81" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# ----------------------------------------------------------------------------
# 1. CANONICALISATION — force HTTPS + www (production domain only)
#    The host condition keeps staging/dev copies unaffected.
# ----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canonicalise to HTTPS + NON-www (matches the live host). Both rules are
    # scoped to the production domain so local/staging copies are unaffected.

    # Consolidate legacy starlabsco.com domain to primary starlabs.com.pk
    RewriteCond %{HTTP_HOST} ^(www\.)?starlabsco\.com$ [NC]
    RewriteRule ^(.*)$ https://starlabs.com.pk/$1 [R=301,L]

    # Normalize multiple consecutive slashes (e.g., //sitemap.xml -> /sitemap.xml)
    RewriteCond %{HTTP_HOST} ^(www\.)?starlabs\.com\.pk$ [NC]
    RewriteCond %{THE_REQUEST} //+ [NC]
    RewriteRule ^(.*)$ https://starlabs.com.pk/$1 [R=301,L,NE]

    # 1) Force HTTPS (proxy-aware: only when neither the connection nor the
    #    forwarded proto is https). Also drops www when arriving over http.
    RewriteCond %{HTTP_HOST} ^(www\.)?starlabs\.com\.pk$ [NC]
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://starlabs.com.pk%{REQUEST_URI} [R=301,L]

    # 2) Force non-www when already on https
    RewriteCond %{HTTP_HOST} ^www\.starlabs\.com\.pk$ [NC]
    RewriteRule ^ https://starlabs.com.pk%{REQUEST_URI} [R=301,L]

    # Remove index.php from URLs for clean canonical paths
    RewriteCond %{THE_REQUEST} \s/+(.*?)index\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # Serve WebP to browsers that accept it when a <file>.webp sibling exists
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{REQUEST_FILENAME}\.webp -f
    RewriteRule ^(.+)\.(jpe?g|png)$ $1.$2.webp [T=image/webp,E=webp:1,L]

    # Fallback for missing product images: serve og-default.jpg so requests never 404
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)img/product/.*\.(jpe?g|png)$ $1img/seo/og-default.jpg [L,NC]
</IfModule>

# WebP negotiation: vary on Accept + correct MIME type
<IfModule mod_headers.c>
    <FilesMatch "\.(jpe?g|png)$">
        Header append Vary Accept
    </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
    AddType image/webp .webp
</IfModule>

# ----------------------------------------------------------------------------
# 2. COMPRESSION — gzip / deflate
# ----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json
    AddOutputFilterByType DEFLATE application/xml application/rss+xml image/svg+xml
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject application/x-font-ttf font/opentype
</IfModule>
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ----------------------------------------------------------------------------
# 3. BROWSER CACHING — leverage expiry headers
# ----------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 month"
    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType text/xml                  "access plus 0 seconds"
    ExpiresByType application/xml           "access plus 0 seconds"
    ExpiresByType application/json          "access plus 0 seconds"
    ExpiresByType application/ld+json       "access plus 0 seconds"
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType text/javascript           "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/gif                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType application/x-font-ttf    "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|php|xml|json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------------
# 4. SECURITY HEADERS
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
    Header always set X-XSS-Protection "1; mode=block"
    # Remove server fingerprinting
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>
ServerSignature Off

# ----------------------------------------------------------------------------
# 5. MIME TYPES & CHARSET
# ----------------------------------------------------------------------------
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddType application/ld+json            .jsonld
    AddType application/manifest+json      .webmanifest
    AddType image/svg+xml                  .svg
    AddType font/woff                      .woff
    AddType font/woff2                     .woff2
    AddType text/plain                     .txt
</IfModule>

# ----------------------------------------------------------------------------
# 6. ACCESS CONTROL — protect sensitive files
# ----------------------------------------------------------------------------
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|bak|sql|ftpquota)$">
    Require all denied
</FilesMatch>
<Files ".ftpquota">
    Require all denied
</Files>

# Disable directory browsing
Options -Indexes

# ----------------------------------------------------------------------------
# 7. ETag — remove (cache-busting handled by Cache-Control)
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

# ----------------------------------------------------------------------------
# 8. CUSTOM ERROR DOCUMENT
# ----------------------------------------------------------------------------
ErrorDocument 404 /404.php
